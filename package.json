{
    "name": "flu3nce-frontend",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite --configLoader runner --mode real",
        "dev:mock": "vite --configLoader runner --mode mock",
        "dev:real": "vite --configLoader runner --mode real",
        "build": "tsc -b && vite build --configLoader runner --mode production",
        "test": "vitest run --configLoader runner --config vitest.config.ts",
        "test:services": "vitest run --configLoader runner --config vitest.config.ts src/services/v2",
        "test:components": "vitest run --configLoader runner --config vitest.config.ts src/components src/hooks",
        "test:integration": "vitest run --configLoader runner --config vitest.config.ts src/mocks/api-store.integration.test.ts",
        "check:contract-pin": "node scripts/check-contract-pin.mjs",
        "check:api-schema": "node scripts/check-api-schema.mjs",
        "check:frontend": "node scripts/check-frontend.mjs",
        "verify:production": "npm run check:frontend && npm run check:contract-pin && npm run check:api-schema && npm test -- --maxWorkers=1 && npm run build && npm run check:frontend -- --dist",
        "verify:v2": "npm run verify:production",
        "preview": "vite preview --configLoader runner",
        "gen:api": "openapi-typescript contract/openapi-v2.yaml -o src/lib/api-schema.d.ts"
    },
    "dependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.18",
        "@untitledui/icons": "^0.0.19",
        "bpmn-auto-layout": "^2.0.0-alpha.2",
        "bpmn-js": "^18.22.1",
        "bpmn-moddle": "^10.1.0",
        "docx-preview": "^0.4.1",
        "jspdf": "^2.5.2",
        "openapi-fetch": "^0.17.0",
        "pdfjs-dist": "^6.3.289",
        "react": "^19.2.3",
        "react-aria-components": "^1.13.0",
        "react-dom": "^19.2.3",
        "react-markdown": "^10.1.0",
        "react-router": "^7.10.1",
        "remark-gfm": "^4.0.1",
        "svg2pdf.js": "^2.2.3",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.0.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/node": "^24.10.4",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "globals": "^16.5.0",
        "jsdom": "^29.1.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.7.4",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.49.0",
        "vite": "^7.3.0",
        "vitest": "^5.0.1"
    }
}
